# ============================================================
# PS-05 Enterprise Intelligence Platform — Environment Example
# ============================================================
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- Neon Serverless PostgreSQL ---
# Create a project at https://neon.tech and copy the pooled or direct
# connection string. Example:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=
# --- JWT ---
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Cookie name used for the auth token (backend)
AUTH_COOKIE_NAME=ps05_token

# --- CORS ---
# Comma-separated list of allowed origins (frontend).
CORS_ORIGIN=http://localhost:5173

# --- Datasets ---
# Maximum accepted dataset upload size in megabytes.
MAX_DATASET_SIZE_MB=100

# Where dataset files are stored locally. Resolved relative to the backend
# working directory. Abstracted behind StorageService so this can later point
# at AWS S3 / Cloudflare R2 / Azure Blob storage.
DATASET_STORAGE_PATH=./storage/datasets

# --- DataMart Supabase Storage (backend-only, never exposed to the frontend) ---
# The complete DataMart CSV is stored as ONE object per dataset in the
# dedicated `datamart-datasets` bucket: datamart-datasets/{user_id}/{dataset_id}.csv
# PostgreSQL stores only dataset metadata + schema (JSONB); DuckDB reads the CSV.
# RAG keeps its own Supabase configuration (SUPABASE_DB_URL + pgvector tables).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATAMART_BUCKET=datamart-datasets