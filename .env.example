# ============================================================
# PS-05 Enterprise Intelligence Platform — Environment Example
# ============================================================
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- Neon Serverless PostgreSQL ---
# Create a project at https://neon.tech and copy the pooled or direct
# connection string. Example:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=
# --- JWT ---
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1h

# Cookie name used for the auth token (backend)
AUTH_COOKIE_NAME=ps05_token

# --- CORS ---
# Comma-separated list of allowed origins (frontend).
CORS_ORIGIN=http://localhost:5173

# --- Datasets ---
# Maximum accepted dataset upload size in megabytes.
MAX_DATASET_SIZE_MB=100

# Local working directory for upload temp files and the scratch cache DuckDB
# reads from. The canonical CSV object lives in Supabase Storage.
DATASET_STORAGE_PATH=./storage/datasets

# --- DataMart Supabase Storage ---
# The complete DataMart CSV is stored as ONE object per dataset in the
# dedicated `datamart-datasets` bucket at
#   datamart-datasets/{user_id}/{dataset_id}.csv
# PostgreSQL stores only dataset metadata + schema (JSONB); DuckDB reads the
# CSV for analytics. The service-role key is backend-only — never expose it
# to the frontend. RAG keeps its own Supabase setup (SUPABASE_DB_URL +
# pgvector tables) and is unaffected by these variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATAMART_BUCKET=datamart-datasets
