# Backend environment (copy to `.env`)
# The root `.env.example` is the canonical reference. Prefer a single
# `.env` at the repository root or in this directory; the backend loads
# `.env` from the backend directory and then from the repository root.

NODE_ENV=development
PORT=5000

DATABASE_URL=
SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@db.ippwqyuwwgsuxuckkhzn.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1h

AUTH_COOKIE_NAME=ps05_token

CORS_ORIGIN=http://localhost:5173

# Datasets
MAX_DATASET_SIZE_MB=100
DATASET_STORAGE_PATH=./storage/datasets
