# Backend environment (copy to `.env`)
# The root `.env.example` is the canonical reference. Prefer a single
# `.env` at the repository root or in this directory; the backend loads
# `.env` from the backend directory and then from the repository root.

NODE_ENV=development
PORT=5000

DATABASE_URL=

SUPABASE_DB_URL=postgresql://postgres.ippwqyuwwgsuxuckkhzn:%40Ramanandi3017@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1h

AUTH_COOKIE_NAME=ps05_token

# Comma-separated list of allowed frontend origins.
# In production, include the Vercel frontend URL.
CORS_ORIGIN=http://localhost:5173,https://biz-intel-blue.vercel.app

# Datasets
MAX_DATASET_SIZE_MB=100
DATASET_STORAGE_PATH=./storage/datasets

# DataMart Supabase Storage (backend-only; never exposed to the frontend).
# Complete CSV objects live in the dedicated `datamart-datasets` bucket.
SUPABASE_URL=https://ippwqyuwwgsuxuckkhzn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATAMART_BUCKET=datamart-datasets